# SprintOS Environment Configuration Example
# Copy this file to .env and fill in your actual credentials

# Client environment (Vite)
VITE_APP_TITLE="SprintOS"
VITE_API_BASE_URL="http://localhost:3001/api"

# Server environment
PORT=3001
NODE_ENV=development
TIMEZONE="Asia/Kolkata"

# Groq AI Inference Configuration
# Get your free fast API key from https://console.groq.com
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="qwen/qwen3.8-27b"

# SMTP Email Dispatch Configuration (18:00 Asia/Kolkata)
# Options:
# 1. Gmail: host="smtp.gmail.com", port=587, user="your-email@gmail.com", pass="your-16-char-app-password"
# 2. Resend: host="smtp.resend.com", port=587, user="resend", pass="re_..."
# 3. Brevo: host="smtp-relay.brevo.com", port=587, user="your-login", pass="your-key"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SprintOS Academic Command Center <reports@sprintos.local>"